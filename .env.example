# Server only. Never use NEXT_PUBLIC_ for credentials.
# HTTPS endpoint from an authorized catalog integrator for BOTH AliExpress stores.
# Store page URLs are not feed URLs. See docs/catalog-integration.md.
ALIEXPRESS_CATALOG_FEED_URL=
ALIEXPRESS_CATALOG_FEED_TOKEN=

# Opt in after accepting this provider's terms and attribution requirement.
GLAMOUR_FX_PROVIDER=
# Supported value: exchange-rate-api

# No default sale margin. Empty/invalid = checkout disabled. Explicit 0 is valid.
GLAMOUR_MARKUP_PERCENT=
GLAMOUR_FIXED_COST_COP_PER_ITEM=0
GLAMOUR_PRICE_ROUNDING_COP=100

# Vercel: connect a PRIVATE Blob store to the project. Vercel injects its token.
# Optional OIDC alternative: BLOB_STORE_ID with the runtime-managed VERCEL_OIDC_TOKEN.
# Never expose either credential in NEXT_PUBLIC_ variables.
BLOB_READ_WRITE_TOKEN=
BLOB_STORE_ID=

# Long random server secret. Vercel Cron sends Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=

# Local / self-hosted only: absolute path on a persistent volume. Empty uses ./data.
# Vercel always uses Blob, even if no store is configured; it never writes to /tmp.
GLAMOUR_DATA_DIR=
