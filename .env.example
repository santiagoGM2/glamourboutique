# Server only. Never use NEXT_PUBLIC_ for credentials.
# HTTPS endpoint from an authorized catalog integrator for BOTH AliExpress stores.
# Store page URLs are not feed URLs. See docs/catalog-integration.md.
ALIEXPRESS_CATALOG_FEED_URL=
ALIEXPRESS_CATALOG_FEED_TOKEN=

# Opt in after accepting this provider's terms and attribution requirement.
GLAMOUR_FX_PROVIDER=
# Supported value: exchange-rate-api

# No default sale margin. Empty/invalid = checkout disabled. Explicit 0 is valid.
GLAMOUR_MARKUP_PERCENT=
GLAMOUR_FIXED_COST_COP_PER_ITEM=0
GLAMOUR_PRICE_ROUNDING_COP=100

# Absolute path on a durable shared volume for the web server and daily sync job.
# Empty uses ./data. Ephemeral serverless filesystems are unsupported.
GLAMOUR_DATA_DIR=
